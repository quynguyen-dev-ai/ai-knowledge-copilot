# Copy to .env and fill in.

# --- API ---
JWT_SECRET=change-me-to-a-long-random-string

# --- AI service ---
# Providers: openai | anthropic | echo (offline demo, no key needed)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Providers: openai | hash (offline demo, no key needed)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Run fully offline with no API keys:
# LLM_PROVIDER=echo
# EMBEDDING_PROVIDER=hash
# EMBEDDING_DIM=384
